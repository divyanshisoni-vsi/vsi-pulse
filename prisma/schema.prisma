generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  manager
  employee
}

enum LogStatus {
  verified
  needs_clarification
  pending
  rejected
}

enum AttendanceStatus {
  present
  leave
  absent
  half_day
}

enum AlertStatus {
  open
  resolved
}

enum UserStatus {
  active
  inactive
}

model Team {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  description  String?
  createdAt    DateTime       @default(now()) @map("created_at")
  users        User[]
  kpiStandards KpiStandard[]

  @@map("teams")
}

model User {
  id                  Int        @id @default(autoincrement())
  name                String
  email               String     @unique
  passwordHash        String     @map("password_hash")
  role                UserRole   @default(employee)
  status              UserStatus @default(active)
  teamId              Int?       @map("team_id")
  jobTitle            String?    @map("job_title")
  employmentType      String     @default("full_time") @map("employment_type")
  onNoticePeriod      Boolean    @default(false) @map("on_notice_period")
  leaveQuotaOverrides Json?      @map("leave_quota_overrides")
  monthlyTarget       Int        @default(0) @map("monthly_target")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at")

  team              Team?          @relation(fields: [teamId], references: [id])
  dailyLogs         DailyLog[]     @relation("UserLogs")
  verifiedLogs      DailyLog[]     @relation("VerifiedLogs")
  attendance        Attendance[]
  relatedAlerts     Alert[]        @relation("RelatedUser")
  resolvedAlerts    Alert[]        @relation("ResolvedBy")
  auditLogs         AuditLog[]
  leaveRequests     LeaveRequest[] @relation("UserLeaveRequests")
  reviewedLeaves    LeaveRequest[] @relation("ReviewedLeaves")

  @@map("users")
}

model KpiStandard {
  id            Int      @id @default(autoincrement())
  teamId        Int      @map("team_id")
  name          String
  description   String?
  targetValue   Decimal  @map("target_value")
  unit          String   @default("units")
  weightPercent Int      @default(100) @map("weight_percent")
  createdAt     DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("kpi_standards")
}

model DailyLog {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  logDate        DateTime  @default(now()) @map("log_date") @db.Date
  activity       String
  quantity       Decimal?
  status         LogStatus @default(pending)
  source         String    @default("manual")
  slackMessageTs String?   @map("slack_message_ts")
  slackChannel   String?   @map("slack_channel")
  rawSlackText   String?   @map("raw_slack_text")
  verifiedBy     Int?      @map("verified_by")
  verifiedAt     DateTime? @map("verified_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  user       User    @relation("UserLogs", fields: [userId], references: [id], onDelete: Cascade)
  verifier   User?   @relation("VerifiedLogs", fields: [verifiedBy], references: [id])
  alerts     Alert[]

  @@map("daily_logs")
}

model Attendance {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  date         DateTime         @db.Date
  hoursWorked  Decimal          @default(0) @map("hours_worked") @db.Decimal(5, 2)
  status       AttendanceStatus @default(present)
  source       String           @default("manual")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("attendance")
}

model Alert {
  id            Int         @id @default(autoincrement())
  type          String
  message       String
  status        AlertStatus @default(open)
  relatedUserId Int?        @map("related_user_id")
  relatedLogId  Int?        @map("related_log_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  resolvedAt    DateTime?   @map("resolved_at")
  resolvedById  Int?        @map("resolved_by")

  relatedUser User?     @relation("RelatedUser", fields: [relatedUserId], references: [id])
  resolvedBy  User?     @relation("ResolvedBy", fields: [resolvedById], references: [id])
  relatedLog  DailyLog? @relation(fields: [relatedLogId], references: [id])

  @@map("alerts")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

model RateLimit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime @map("reset_at")

  @@map("rate_limits")
}

model LeavePolicyConfig {
  id                              Int      @id @default(autoincrement())
  policyTitle                     String   @default("Virtual Solutions India (VSI) - HR Policy") @map("policy_title")
  effectiveDate                   String   @default("2026-07-13") @map("effective_date")
  issuedBy                        String   @default("HR Department") @map("issued_by")
  approvedBy                      String   @default("Amit Jain (Managing Director)") @map("approved_by")
  standardWorkdayHours            Decimal  @default(8) @map("standard_workday_hours") @db.Decimal(4, 2)
  carryForwardEnabled             Boolean  @default(false) @map("carry_forward_enabled")
  requireThreeStepProcess         Boolean  @default(true) @map("require_three_step_process")
  blockLeaveOnNoticePeriod        Boolean  @default(true) @map("block_leave_on_notice_period")
  unauthorizedDeductionMultiplier Decimal  @default(1.5) @map("unauthorized_deduction_multiplier") @db.Decimal(3, 1)
  shiftChangeMinNoticeHours       Int      @default(2) @map("shift_change_min_notice_hours")
  leaveTypes                      Json     @map("leave_types")
  guidelinesNotes                 Json?    @map("guidelines_notes")
  updatedBy                       String?  @map("updated_by")
  updatedAt                       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("leave_policies")
}

model LeaveRequest {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  leaveTypeKey      String    @map("leave_type_key")
  leaveTypeName     String    @map("leave_type_name")
  durationMode      String    @default("full_day") @map("duration_mode")
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime  @map("end_date") @db.Date
  hoursRequested    Decimal   @map("hours_requested") @db.Decimal(6, 2)
  reason            String
  handoverNotes     String?   @map("handover_notes")
  documentRef       String?   @map("document_ref")
  slackInformed     Boolean   @default(false) @map("slack_informed")
  hrEmailSent       Boolean   @default(false) @map("hr_email_sent")
  jibbleApplied     Boolean   @default(false) @map("jibble_applied")
  status            String    @default("pending")
  isLwp             Boolean   @default(false) @map("is_lwp")
  penaltyMultiplier Decimal   @default(1.0) @map("penalty_multiplier") @db.Decimal(3, 1)
  policyWarnings    Json?     @map("policy_warnings")
  reviewerNotes     String?   @map("reviewer_notes")
  reviewedBy        Int?      @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  user     User  @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewedLeaves", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

model PublicHoliday {
  id           Int      @id @default(autoincrement())
  date         DateTime @db.Date
  name         String
  type         String   @default("Official Holiday")
  syncedJibble Boolean  @default(true) @map("synced_jibble")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("public_holidays")
}
